# Згенерувати ключ: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# True під час розробки, False у продакшені
DEBUG=True

# При деплої в ALLOWED_HOSTS буде власний домен
# ALLOWED_HOSTS=myapi.com,www.myapi.com

# PostgreSQL
DB_NAME=study_platform
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_HOST=localhost # DB_HOST=localhost для локальної розробки; DB_HOST=db - devcontainer
DB_PORT=5432

# URL фронтенду (Next.js) — використовується у листах і як default для CORS
FRONTEND_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Invoice issuer details
INVOICE_COMPANY_NAME=Nexo4You
INVOICE_COMPANY_EMAIL=accounts@example.com
INVOICE_COMPANY_ADDRESS=Your company address

# CORS — за замовчуванням дорівнює FRONTEND_URL; задавати тільки для додаткових origins
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Celery (фонова відправка листів через Redis-брокер)
# redis://redis:6379/0 у devcontainer; redis://localhost:6379/0 поза compose
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CHANNEL_REDIS_URL=redis://redis:6379/0
CHANNEL_REDIS_SOCKET_TIMEOUT=10
CHANNEL_REDIS_SOCKET_CONNECT_TIMEOUT=5

# Django application cache. Use a database separate from Celery and Channels.
CACHE_URL=redis://redis:6379/1
CACHE_DEFAULT_TIMEOUT=300
CACHE_TTL_JITTER_SECONDS=60
CACHE_STAMPEDE_LOCK_TIMEOUT=10
CACHE_STAMPEDE_WAIT_TIMEOUT=2
CACHE_STAMPEDE_POLL_INTERVAL=0.05
PUBLIC_COURSE_DETAIL_CACHE_TIMEOUT=600
PUBLIC_CATEGORY_CACHE_TIMEOUT=600
PUBLIC_USER_PROFILE_CACHE_TIMEOUT=600
PUBLIC_LESSON_CACHE_TIMEOUT=600
COURSE_PROGRESS_CACHE_TIMEOUT=60
CACHE_KEY_PREFIX=nexo_platform
CACHE_REDIS_SOCKET_TIMEOUT=2
CACHE_REDIS_SOCKET_CONNECT_TIMEOUT=2

# Chat
CHAT_MESSAGE_MAX_LENGTH=4000
CHAT_ATTACHMENT_MAX_BYTES=26214400
CHAT_ATTACHMENT_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,text/plain,application/zip

# Email
# DEBUG=True: листи друкуються в термінал, ці змінні не потрібні
# DEBUG=False: потрібен реальний SMTP
# Gmail: Account → Security → 2-Step Verification → App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# S3 — required when DEBUG=False. With IAM roles, leave credentials unset.
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=eu-central-1
# AWS_S3_ENDPOINT_URL=https://s3.eu-central-1.amazonaws.com
